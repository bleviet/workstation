#!/usr/bin/env bash
# with-secrets: run a command with API keys taken from KeePassXC, so no key
# ever sits in a plain file (.env, shell profile, history).
#
# Usage: with-secrets NAME [NAME...] -- command [args...]
#   with-secrets OPENAI_API_KEY GEMINI_API_KEY -- python main.py
#   with-secrets OPENAI_API_KEY -- uv run jupyter lab
#
# Each NAME is read from the Password field of entry <group>/<NAME> and
# exported only into the command's environment. Asks for the master password
# once per run.
#
#   KEEPASS_DB     database (default ~/synology/Documents/Personal/keepass/mp.kdbx)
#   KEEPASS_GROUP  group holding the entries (default Dev/API; no root group name)
#   KEEPASS_KEYFILE  optional key file
set -euo pipefail

usage() { sed -n '4,7p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

db="${KEEPASS_DB:-$HOME/synology/Documents/Personal/keepass/mp.kdbx}"
group="${KEEPASS_GROUP:-Dev/API}"

names=()
while [[ $# -gt 0 && "$1" != "--" ]]; do names+=("$1"); shift; done
[[ $# -gt 0 ]] || usage           # no "--"
shift
[[ ${#names[@]} -gt 0 && $# -gt 0 ]] || usage

for n in "${names[@]}"; do
  [[ "$n" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "with-secrets: not a variable name: $n" >&2; exit 2; }
done

cli="$(command -v keepassxc-cli || true)"
if [[ -z "$cli" && -x /Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli ]]; then
  cli=/Applications/KeePassXC.app/Contents/MacOS/keepassxc-cli
fi
[[ -n "$cli" ]] || { echo "with-secrets: keepassxc-cli not found (install KeePassXC)" >&2; exit 1; }
[[ -f "$db" ]] || { echo "with-secrets: database not found: $db (NAS share mounted? set KEEPASS_DB)" >&2; exit 1; }

opts=(-q)
[[ -n "${KEEPASS_KEYFILE:-}" ]] && opts+=(--key-file "$KEEPASS_KEYFILE")

read -rsp "KeePassXC master password ($(basename "$db")): " pw || true
echo >&2

for n in "${names[@]}"; do
  # Assign first: `export x=$(...)` would hide a failed lookup from set -e.
  if ! value="$(printf '%s\n' "$pw" | "$cli" show "${opts[@]}" -a Password "$db" "$group/$n")"; then
    unset pw
    echo "with-secrets: could not read $group/$n (wrong password or no such entry)" >&2
    exit 1
  fi
  [[ -n "$value" ]] || { unset pw; echo "with-secrets: $group/$n has an empty password field" >&2; exit 1; }
  export "$n=$value"
done
unset pw value

exec "$@"
